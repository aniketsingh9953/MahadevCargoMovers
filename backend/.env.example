# Copy this file to .env and fill in your own values before running the server.
# NEVER commit your real .env file to GitHub.

# A long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Default admin account created the first time you run "npm run init-db"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=mahadev@2026

# Port the backend server listens on
PORT=4000

# Allowed origin for the frontend (use * for local testing, your real domain in production)
CORS_ORIGIN=*
